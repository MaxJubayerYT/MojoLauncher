<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/_260sdp">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/padding_heavy"
    android:paddingBottom="@dimen/padding_large"
    android:paddingTop="@dimen/padding_heavy"
    >

    <!-- Version filter (also used as the target for update checking) -->
    <TextView
        android:id="@+id/manage_filter_mc_version_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profiles_profile_version"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@+id/manage_filter_selected_mc_version_textview" />

    <TextView
        android:id="@+id/manage_filter_selected_mc_version_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_medium"
        android:background="@drawable/background_line"
        android:hint="@string/version_select_hint"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintEnd_toStartOf="@+id/manage_filter_mc_version_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_mc_version_textview" />

    <Button
        android:id="@+id/manage_filter_mc_version_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/padding_large"
        android:text="@string/global_select"
        app:layout_constraintBottom_toBottomOf="@+id/manage_filter_selected_mc_version_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/manage_filter_selected_mc_version_textview" />

    <!-- Loader filter -->
    <TextView
        android:id="@+id/manage_filter_loader_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:text="@string/mod_loader_filter_label"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_selected_mc_version_textview"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/manage_filter_loader_spinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/background_line"
        android:paddingHorizontal="@dimen/padding_heavy"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_loader_textview" />

    <!-- Show filter -->
    <TextView
        android:id="@+id/manage_filter_show_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:text="@string/mod_filter_show_label"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_loader_spinner"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/manage_filter_show_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_show_textview">

        <RadioButton
            android:id="@+id/manage_filter_show_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_filter_all" />

        <RadioButton
            android:id="@+id/manage_filter_show_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_filter_enabled" />

        <RadioButton
            android:id="@+id/manage_filter_show_disabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_filter_disabled" />

        <RadioButton
            android:id="@+id/manage_filter_show_updates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mod_filter_has_update" />

    </RadioGroup>

    <!-- Automatic update checking on/off -->
    <TextView
        android:id="@+id/manage_filter_auto_update_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:text="@string/mod_auto_update_check_label"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_show_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/manage_filter_auto_update_switch"
        app:layout_constraintBottom_toBottomOf="@id/manage_filter_auto_update_switch" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/manage_filter_auto_update_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_show_group"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Apply -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/manage_filter_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/generic_apply"
        android:layout_marginVertical="@dimen/padding_large"
        app:layout_constraintTop_toBottomOf="@id/manage_filter_auto_update_switch" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
